# This is an example environment file.
# Copy this file to .env and fill in your actual API keys and configuration.

# Figma API Key (Required)
# Get yours from Figma account settings > Personal access tokens
FIGMA_API_KEY="your_figma_api_key_here"

# OpenAI API Key (Required)
# Get yours from https://platform.openai.com/account/api-keys
OPENAI_API_KEY="your_openai_api_key_here"

# Embedding Model Name (Optional)
# If not set, defaults to 'all-MiniLM-L6-v2' in config.py
# You can specify any other compatible sentence transformer model.
# Example: EMBEDDING_MODEL_NAME="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"
# EMBEDDING_MODEL_NAME="your_embedding_model_name_here"

# ChromaDB Path (Optional)
# If not set, defaults to "./chroma_data" in config.py
# This is where ChromaDB will store its data files.
# CHROMA_DB_PATH="./your_custom_chroma_data_path"

# Chroma Collection Name (Optional)
# If not set, defaults to "react_components" in config.py
# This is the name of the collection within ChromaDB where embeddings will be stored.
# CHROMA_COLLECTION_NAME="your_custom_collection_name"
